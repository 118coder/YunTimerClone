<ui:FluentWindow x:Class="YunTimerClone.ConfirmDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="关机提示"
                 Width="400" Height="330"
                 MinWidth="400" MaxWidth="400" MinHeight="330" MaxHeight="330"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize"
                 Topmost="True"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="TimerAccentBrush" Color="#60CDFF"/>
        <SolidColorBrush x:Key="TimerDestructiveBrush" Color="#DC2626"/>
    </Window.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" ShowMinimize="False" ShowMaximize="False" ShowClose="False" Height="12"/>

        <StackPanel Grid.Row="1" Margin="28,10,28,24">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:SymbolIcon x:Name="WarnIcon" Symbol="Warning24" FontSize="22" Foreground="{StaticResource TimerDestructiveBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="WarnText" Text="关机提醒：请注意保存文件！"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource TimerDestructiveBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 倒计时圆环（借鉴 Material Design 进度环） -->
            <Grid Width="112" Height="112" Margin="0,18,0,6" HorizontalAlignment="Center">
                <Ellipse Stroke="#1FFFFFFF" StrokeThickness="6"/>
                <Path x:Name="ArcPath" Stroke="{StaticResource TimerAccentBrush}" StrokeThickness="6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <TextBlock x:Name="RemainSeconds" Text="60" FontSize="26" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="BodyText" Text="" FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"/>

            <UniformGrid Columns="3" Margin="0,24,0,0">
                <ui:Button x:Name="BtnExecute" Content="执  行" Appearance="Danger"
                           Height="38" FontWeight="SemiBold" Cursor="Hand"
                           Margin="0,0,6,0" Click="OnExecute"/>
                <ui:Button x:Name="BtnDelay" Content="延迟 10 分钟" Appearance="Secondary"
                           Height="38" Cursor="Hand"
                           Margin="6,0" Click="OnDelay"/>
                <ui:Button x:Name="BtnCancel" Content="取  消" Appearance="Secondary"
                           Height="38" Cursor="Hand"
                           Margin="6,0,0,0" Click="OnCancel"/>
            </UniformGrid>

        </StackPanel>
    </Grid>
</ui:FluentWindow>
